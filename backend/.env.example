# ORCUS Master Backend Environment Configuration (Example Template)
# Copy this file to .env and configure values for your environment.

PORT=5050
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orcus_db

# Cryptographic Secret: Replace with a secure 32+ character random key in production
JWT_SECRET=replace-with-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=24h
GIN_MODE=release

# Allowed frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:7700,http://localhost:3000

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
